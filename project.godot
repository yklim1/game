; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Feral Bloom (Prototype)"
config/description="동물 진화/변이 2D 로그라이트 서바이버. 귀엽지만 다크한 톤. 1인 개발 프로토타입."
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
run/main_scene="res://scenes/main/game.tscn"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
ContentDB="*res://scripts/autoload/content_db.gd"
RunState="*res://scripts/autoload/run_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

; 새로 추가되는 스프라이트(PNG)의 임포트 기본값. 근거는 docs/ART_ASSET_SPEC.md 참고.
; 이미 임포트된 파일에는 적용되지 않으므로(파일별 .import 가 우선) 기존 파일은 .import 를 지우고 재임포트해야 한다.
texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": true,
"process/fix_alpha_border": true
}

[input]

move_left={
"deadzone": 0.5,
